# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local

# Mode: direct | mock | proxy
VITE_TMDB_MODE=mock

# For "direct" mode — Bearer Read Access Token from TMDB Settings → API
# VITE_TMDB_TOKEN=your_bearer_token_here

# Alternative: use API key as query param instead of Bearer header
# VITE_TMDB_API_KEY=your_api_key_here
